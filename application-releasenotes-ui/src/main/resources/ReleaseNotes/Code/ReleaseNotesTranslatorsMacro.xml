    <property>
      <code>{{velocity}}
## The translated languages are stored in a deterministic "Translators" child page of the current
## release note page, carrying an EntryClass envelope + one TranslatorsClass object per language.
#set ($rnSpaceReference = $doc.documentReference.lastSpaceReference)
#set ($translatorsSpaceReference = $services.model.createSpaceReference('Translators', $rnSpaceReference))
#set ($translatorsReference = $services.model.createDocumentReference('WebHome', $translatorsSpaceReference))
#set ($translatorsDoc = $xwiki.getDocument($translatorsReference))
#set ($languageObjects = $translatorsDoc.getObjects("ReleaseNotes.Code.TranslatorsClass"))
## Sort the language names alphabetically, ignoring case, before rendering them.
#set ($sortedLanguages = [])
#foreach ($languageObject in $languageObjects)
#set ($name = "$!languageObject.getValue('language')")
#set ($name = $name.trim())
#if ($name != '')
#set ($index = $sortedLanguages.size())
#foreach ($existing in $sortedLanguages)
#if ($name.compareToIgnoreCase($existing) &lt; 0)
#set ($index = $foreach.index)
#break
#end
#end
#set ($discard = $sortedLanguages.add($index, $name))
#end
#end
#if ($sortedLanguages.isEmpty())
{{warning}}{{translation key="releasenotes.translators.notGenerated"/}}{{/warning}}
#else
{{translation key="releasenotes.translators.intro"/}}

{{language codes=$stringtool.join($sortedLanguages,',')}}{{/language}}

#end
## Edit affordance: only for editors on a not-yet-released note, mirroring the contributors macro.
#set ($released = "$!doc.getValue('released')")
#if ($hasEdit &amp;&amp; $released != '1')
#set ($product = "$!doc.getValue('product')")
#set ($version = "$!doc.getValue('version')")
#if (!$languageObjects.isEmpty())
## Present: a pencil edit link opening the Translators page in edit mode.
#set ($editText = $services.localization.render('edit'))
#set ($iconHTML = $services.icon.renderHTML('pencil'))
#set ($hrefAttribute = "$translatorsDoc.getURL('edit', ""editor=inline&amp;xredirect=$doc.getURL('view')"")")
{{html clean="false"}}&lt;a class="edit_section" role="button" title="$editText" href="$hrefAttribute"&gt;${iconHTML}&lt;span class="sr-only"&gt;$editText&lt;/span&gt;&lt;/a&gt;{{/html}}
#else
## Absent: an "Add translated languages" button opening the Translators page in inline mode from the template.
{{html clean="false"}}
&lt;form action="$translatorsDoc.getURL('edit')" method="get"&gt;
  &lt;input type="hidden" name="editor" value="inline"/&gt;
  &lt;input type="hidden" name="xhidden" value="1"/&gt;
  &lt;input type="hidden" name="template" value="ReleaseNotes.Code.TranslatorsTemplate"/&gt;
  &lt;input type="hidden" name="product" value="$escapetool.xml($product)"/&gt;
  &lt;input type="hidden" name="version" value="$escapetool.xml($version)"/&gt;
  &lt;input type="hidden" name="type" value="Translators"/&gt;
  &lt;input type="hidden" name="xredirect" value="$escapetool.xml($doc.getURL('view'))"/&gt;
  &lt;span class="buttonwrapper"&gt;
    &lt;input class="button" type="submit" value="$escapetool.xml($services.localization.render('releasenotes.translators.submit'))"/&gt;
  &lt;/span&gt;
&lt;/form&gt;
{{/html}}
#end
#end
{{/velocity}}
</code>
