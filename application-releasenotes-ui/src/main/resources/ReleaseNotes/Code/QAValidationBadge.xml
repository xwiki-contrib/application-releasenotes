    <property>
      <content>{{velocity}}
## The badge saying whether Manual QA has validated the version of the release note being viewed. It is displayed only
## on a release note, and only when the administrator turned it on, since not every product has its versions
## manually tested. The release note is looked for first because this runs on the view of every page of the wiki. A
## version Manual QA has not tested, which is also what a release note created before the validation existed holds,
## displays nothing.
#set ($releaseNoteObject = $doc.getObject('ReleaseNotes.Code.ReleaseNoteClass'))
#if ($releaseNoteObject)
#set ($qaValidation = "$!releaseNoteObject.getValue('qaValidation')")
#set ($configDocument = $xwiki.getDocument('ReleaseNotes.Code.ReleaseNotesConfig'))
#set ($configObject = $configDocument.getObject('ReleaseNotes.Code.ReleaseNotesConfigClass'))
#set ($displayed = "$!configObject.getValue('displayQAValidation')" == '1')
#if ($displayed &amp;&amp; ($qaValidation == 'validated' || $qaValidation == 'notValidated'))
#set ($discard = $xwiki.ssx.use('ReleaseNotes.Code.QAValidationBadge'))
#set ($qaValidationDate = $releaseNoteObject.getValue('qaValidationDate'))
#if ($qaValidation == 'validated' &amp;&amp; "$!qaValidationDate" != '')
#set ($formattedDate = $datetool.format('medium_date', $qaValidationDate, $xcontext.locale))
#set ($tooltip = $services.localization.render('releasenotes.qaValidation.validated.dateTooltip', [$formattedDate]))
#else
#set ($tooltip = $services.localization.render("releasenotes.qaValidation.${qaValidation}.tooltip"))
#end
#set ($label = $services.localization.render('releasenotes.qaValidation.label'))
#set ($status = $services.localization.render("releasenotes.qaValidation.$qaValidation"))
## The tooltip says what the badge means. Assistive technologies get that meaning once, from the hidden text, since
## the visible parts carrying the tooltip are hidden from them.
{{html clean="false"}}
&lt;div class="rn-qa-badge-header"&gt;&lt;span class="rn-qa-badge rn-qa-badge-$qaValidation"&gt;&lt;span class="rn-qa-badge-label" title="$escapetool.xml($tooltip)" aria-hidden="true"&gt;$escapetool.xml($label)&lt;/span&gt;&lt;span class="rn-qa-badge-status" title="$escapetool.xml($tooltip)" aria-hidden="true"&gt;$escapetool.xml($status)&lt;/span&gt;&lt;span class="sr-only"&gt;$escapetool.xml("$label: $status. $tooltip")&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
{{/html}}
#end
#end
{{/velocity}}</content>
