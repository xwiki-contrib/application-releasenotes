    <property>
      <code>require(['jquery', 'xwiki-events-bridge'], function($) {
  // The Screenshots picker is a multiple SELECT, but 'screenshots' is a String property, for which
  // XWiki only keeps the first submitted value. The comma separated list expected by the release
  // note displayers is therefore carried by a hidden input, kept in sync with the picker here.
  var syncPicker = function(picker) {
    var $picker = $(picker);
    $picker.closest('.releasenotes-screenshots').find('input.releasenotes-screenshots-value')
      .val(($picker.val() || []).join(','));
  };
  var syncAllPickers = function($container) {
    $container.find('select.releasenotes-screenshots-picker').each(function() {
      syncPicker(this);
    });
  };
  var init = function(event, data) {
    $((data &amp;&amp; data.elements) || document).find('select.releasenotes-screenshots-picker')
      .each(function() {
        syncPicker(this);
        $(this).on('change', function() {
          syncPicker(this);
        });
      });
  };
  $(document).on('xwiki:dom:updated', init);
  // Sync once more right before the value is sent, so that a change event missed by the widget
  // cannot silently drop a screenshot. Covers both the standard submit and the AJAX save.
  $(document).on('submit', 'form', function() {
    syncAllPickers($(this));
  });
  $(document).on('xwiki:actions:beforeSave', function() {
    syncAllPickers($(document));
  });
  $(init);
});</code>
