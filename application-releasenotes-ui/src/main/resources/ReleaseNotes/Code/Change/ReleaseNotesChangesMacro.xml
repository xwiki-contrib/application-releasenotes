    <property>
      <code>{{include reference="ReleaseNotes.Code.EntryVelocityMacros"/}}

{{velocity output="false"}}
## Each section is a page of changes, so it can leave changes out. Say so rather than let a release note look
## complete while it is not: this is the only sign an author gets that the limit needs raising.
#macro (displayTruncationWarning $hasMore $miscHasMore)
  #if ($hasMore || $miscHasMore)
(% class="box warningmessage" %)(((
{{translation key="releasenotes.changes.truncated"/}}
)))
  #end
#end

## What the sections of a release note are, and how their changes are split, comes from the Java API. What is left
## here is how each of them is named: in the translation keys, in the action its "Add … Change" form posts, and in the
## variables its changes are published under, which are the names the getChanges calls of this macro used.
#set ($sectionNames = {
  'user': {'key': 'user', 'action': 'useradd', 'variable': 'user'},
  'administrator': {'key': 'admin', 'action': 'adminadd', 'variable': 'admin'},
  'developer': {'key': 'developer', 'action': 'devadd', 'variable': 'dev'}
})
{{/velocity}}

{{velocity}}
## The versions the changes are gathered from: a milestone or a release candidate gathers its own changes, whereas
## a final release note also gathers the ones of its milestones and of its release candidates. They are derived
## from the page name, which has to be named using the short version syntax, e.g. "8.3M1".
#set ($versionsParameter = $stringtool.join($services.releasenotes.getAggregatedVersions($doc.documentReference), ','))
## Extract product + version + released info from xobject
#set ($product = $!doc.getValue('product'))
#set ($version = $!doc.getValue('version'))
#set ($released = $!doc.getValue('released'))
## Handle the add-change actions and show their buttons only when the current user can edit the note and the note is
## not released. The button being hidden otherwise is not by itself what keeps the action from running.
#set ($canAddChanges = $hasEdit &amp;&amp; $released != '1')
## The changes of the product of the note and of the versions it gathers, but the excluded ones, which are left out
## by the search itself so that they do not count against the limit of a section. The filters are read the way the
## getChanges macro reads its parameters, since this is what they are.
#set ($changesQuery = $services.releasenotes.parseQuery({
  'products': "$!product",
  'versions': $versionsParameter,
  'exclusions': "$!wikimacro.parameters.exclusions",
  'limit': "$!wikimacro.parameters.limit"
}))
## Decide whether or not display edit links for changes: only display them when the current user has edit rights on
## the current page
#set ($displayEditLink = $hasEdit)
#foreach ($section in $services.releasenotes.getSections($changesQuery))
  #set ($sectionName = $sectionNames.get($section.audience.storedValue))
  #set ($sectionChanges = $services.releasenotes.search($section.mainChanges))
  #set ($sectionMiscChanges = $services.releasenotes.search($section.miscellaneousChanges))
  ## The changes are displayed by the displayChanges macro, which runs once this whole script has, so each section
  ## publishes them under names of its own.
  #set ($changesVariable = "${sectionName.variable}Changes")
  #set ($miscChangesVariable = "${sectionName.variable}MiscChanges")
  #setVariable("$changesVariable", $sectionChanges.changeNames)
  #setVariable("$miscChangesVariable", $sectionMiscChanges.changeNames)
== {{translation key="releasenotes.changes.${sectionName.key}.heading"/}} ==
  #if ($canAddChanges &amp;&amp; "$!request.action" == $sectionName.action &amp;&amp; $services.csrf.isTokenValid($request.getParameter('form_token')))
    #handleAddAction($product, $version, "${request.queryString}&amp;xredirect=$doc.getURL('view')")
  #end
  #if ($canAddChanges)
{{html clean='false'}}
&lt;form&gt;
  &lt;input type="hidden" name="action" value="$sectionName.action"/&gt;
  &lt;input type="hidden" name="form_token" value="$!escapetool.xml($services.csrf.token)"/&gt;
  &lt;input type="hidden" name="template" value="ReleaseNotes.Code.Change.ChangeTemplate"/&gt;
  &lt;input type="hidden" name="product" value="$!escapetool.xml($product)"/&gt;
  &lt;input type="hidden" name="version" value="$!escapetool.xml($version)"/&gt;
  &lt;input type="hidden" name="audience" value="$section.audience.storedValue"/&gt;
  &lt;span class="buttonwrapper"&gt;
    &lt;input class="button" type="submit" value="$escapetool.xml($services.localization.render("releasenotes.changes.${sectionName.key}.submit"))"/&gt;
  &lt;/span&gt;
&lt;/form&gt;
{{/html}}
  #end

  #if ($sectionChanges.changeNames.size() == 0)
    #if ($sectionMiscChanges.changeNames.size() == 0)
    {{translation key="releasenotes.changes.${sectionName.key}.nochanges"/}}
    #else
    {{displayChanges displayer="list" displayEditLink="$displayEditLink" contextVariable="$miscChangesVariable"/}}
    #end
  #else
  {{displayChanges displayer="simple" displayEditLink="$displayEditLink" contextVariable="$changesVariable"/}}

    #if ($sectionMiscChanges.changeNames.size() &gt; 0)
    === {{translation key="releasenotes.changes.${sectionName.key}.miscellaneous"/}} ===

    {{displayChanges displayer="list" displayEditLink="$displayEditLink" contextVariable="$miscChangesVariable"/}}
    #end
  #end
  #displayTruncationWarning($sectionChanges.hasMore(), $sectionMiscChanges.hasMore())
#end
{{/velocity}}</code>
