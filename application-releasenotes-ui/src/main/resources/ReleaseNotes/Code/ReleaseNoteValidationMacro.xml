      <code>/* A two-part shield: a neutral label, then the status in the colours of the matching message box, which the colour
   theme keeps readable. */
.rn-qa-badge {
  display: inline-flex;
  vertical-align: middle;
  border-radius: @border-radius-base;
  overflow: hidden;
  font-size: 85%;
  line-height: 1.8;
  white-space: nowrap;
  cursor: help;

  .rn-qa-badge-label,
  .rn-qa-badge-status {
    padding: 0 .6em;
    border: 1px solid transparent;
  }

  .rn-qa-badge-label {
    color: #fff;
    background-color: @gray-dark;
    border-color: @gray-dark;
  }
}

.rn-qa-badge-validated .rn-qa-badge-status {
  color: @state-success-text;
  background-color: @state-success-bg;
  border-color: @state-success-border;
}

.rn-qa-badge-notValidated .rn-qa-badge-status {
  color: @state-danger-text;
  background-color: @state-danger-bg;
  border-color: @state-danger-border;
}</code>
