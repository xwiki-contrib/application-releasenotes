    <property>
      <code>{{velocity}}
## The badge of the release note the macro is on. A version Manual QA has not tested, which is also what a release note
## holds that was created before the validation existed, displays nothing.
#set ($releaseNoteObject = $doc.getObject('ReleaseNotes.Code.ReleaseNoteClass'))
#set ($qaValidation = "$!releaseNoteObject.getValue('qaValidation')")
#if ($qaValidation == 'validated' || $qaValidation == 'notValidated')
#set ($discard = $xwiki.ssx.use('ReleaseNotes.Code.ReleaseNoteValidationMacro'))
#set ($qaValidationDate = $releaseNoteObject.getValue('qaValidationDate'))
#if ($qaValidation == 'validated' &amp;&amp; "$!qaValidationDate" != '')
#set ($formattedDate = $datetool.format('medium_date', $qaValidationDate, $xcontext.locale))
#set ($tooltip = $services.localization.render('releasenotes.qaValidation.validated.dateTooltip', [$formattedDate]))
#else
#set ($tooltip = $services.localization.render("releasenotes.qaValidation.${qaValidation}.tooltip"))
#end
#set ($label = $services.localization.render('releasenotes.qaValidation.label'))
#set ($status = $services.localization.render("releasenotes.qaValidation.$qaValidation"))
## The tooltip is what says what the badge means, so it is also given to screen readers, which do not read titles.
{{html clean="false"}}&lt;span class="rn-qa-badge rn-qa-badge-$qaValidation" title="$escapetool.xml($tooltip)"&gt;&lt;span class="rn-qa-badge-label" aria-hidden="true"&gt;$escapetool.xml($label)&lt;/span&gt;&lt;span class="rn-qa-badge-status" aria-hidden="true"&gt;$escapetool.xml($status)&lt;/span&gt;&lt;span class="sr-only"&gt;$escapetool.xml("$label: $status. $tooltip")&lt;/span&gt;&lt;/span&gt;{{/html}}
#end
{{/velocity}}</code>
